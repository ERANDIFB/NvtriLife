<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">


    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="NvtriLife"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NvtriLife">

        <!-- 1. MainActivity con su intent-filter -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Las demás actividades declaradas de forma independiente -->
        <activity android:name=".LoginActivity" android:exported="false" />
        <activity android:name=".UneteActivity" android:exported="false" />
        <activity android:name=".RegistroPacienteActivity" android:exported="false" />
        <activity android:name=".RegistroNutriologaActivity" android:exported="false" />
        <activity android:name=".EnRevisionActivity" android:exported="false" />
        <activity android:name=".AdminHomeActivity" android:exported="false" />
        <activity android:name=".SolicitudDetalleActivity" android:exported="false" />
        <activity android:name=".PacienteHomeActivity" android:exported="false" />
        <activity android:name=".NutriologaHomeActivity" android:exported="false" />
    </application>

</manifest>